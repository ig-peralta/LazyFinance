' Shared visual language from the unchanged conceptual PNGs.
' UML roles, not deployment status, determine colour. Status is written explicitly.
' Graphviz supplies layout locally; no diagram server or application service is used.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam defaultTextAlignment center
skinparam stereotypeFontStyle italic
skinparam ArrowColor #334155
skinparam ArrowThickness 1.5
skinparam roundcorner 8
skinparam padding 8
skinparam nodesep 35
skinparam ranksep 45
skinparam linetype polyline
