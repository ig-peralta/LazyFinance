{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "NODE_ENV",
        "AUTH_*",
        "FIREBASE_*",
        "CORS_ORIGINS",
        "PERSISTENCE_*",
        "POSTGRES_*"
      ],
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_*"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
