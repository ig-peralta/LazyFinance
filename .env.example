# Local Docker Compose configuration for docker/local/deploy.yml.
# Copy to .env in the repository root; these are demo-only defaults.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=lazyfinance
PERSISTENCE_DATABASE_USER=lazyfinance_app
PERSISTENCE_DATABASE_PASSWORD=local-runtime-password-change-me
# Generate a fresh pair using pnpm rpc:keys, then paste the two PEM variables here.
PERSISTENCE_RPC_PRIVATE_KEY=
PERSISTENCE_RPC_PUBLIC_KEY=
PERSISTENCE_RPC_KEY_ID=primary
API_PORT=3000
UI_PORT=4200
AUTH_PROVIDER=mock
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# For Firebase mode, select AUTH_PROVIDER=firebase and supply a real project ID
# through the local shell/Compose environment. Never commit service-account keys.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=service-account@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=your-private-key

# Optional Fintoc Movements linking; pass all three to the API only.
# FINTOC_PUBLIC_KEY=pk_test_REPLACE_ME
# FINTOC_SECRET_KEY=sk_test_REPLACE_ME
# FINTOC_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
