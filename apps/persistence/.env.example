# Generate a fresh pair with pnpm rpc:keys. Only the API receives the private key.
PORT=3001
HOST=127.0.0.1
PERSISTENCE_RPC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
PERSISTENCE_RPC_KEY_ID=primary

# Runtime login: NOT a table/schema owner, superuser or BYPASSRLS role.
POSTGRES_RUNTIME_URL=postgresql://lazyfinance_app:replace-with-runtime-password@localhost:5432/lazyfinance

# OWNER-ONLY CLI environment, never provide these to the running service:
# POSTGRES_MIGRATION_URL=postgresql://owner:owner-password@localhost:5432/lazyfinance
# PERSISTENCE_DATABASE_USER=lazyfinance_app
# PERSISTENCE_DATABASE_PASSWORD=replace-with-a-password-of-at-least-16-characters
