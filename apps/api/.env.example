# For running the API directly from apps/api (pnpm --filter api dev).
# Copy to apps/api/.env. Drizzle CLI commands read POSTGRES_URL from the shell,
# not from this file; export it separately for a non-default database.
NODE_ENV=development
AUTH_PROVIDER=mock
PORT=3000
POSTGRES_URL=postgresql://user:password@localhost:5432/postgres
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# For Firebase instead of local mock auth, set AUTH_PROVIDER=firebase and a real
# FIREBASE_PROJECT_ID. Admin email/private key are optional but must be paired.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=service-account@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=your-private-key
