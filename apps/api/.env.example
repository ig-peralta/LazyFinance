# For running the API directly from apps/api (pnpm --filter api dev).
# Copy to apps/api/.env. Never put any PostgreSQL URL in this runtime environment.
NODE_ENV=development
AUTH_PROVIDER=mock
PORT=3000
PERSISTENCE_RPC_URL=http://127.0.0.1:3001
# Generate with pnpm rpc:keys. Only the API receives the private key.
PERSISTENCE_RPC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
PERSISTENCE_RPC_KEY_ID=primary
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# For Firebase instead of local mock auth, set AUTH_PROVIDER=firebase and a real
# FIREBASE_PROJECT_ID. Admin email/private key are optional but must be paired.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=service-account@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=your-private-key

# Optional Fintoc Movements integration. Configure all three together, API-only.
# Public/secret keys must use the same mode; keep real values in ignored local files.
# FINTOC_PUBLIC_KEY=pk_test_REPLACE_ME
# FINTOC_SECRET_KEY=sk_test_REPLACE_ME
# Separate stable 32-byte encryption key, represented as 64 hex characters.
# FINTOC_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
