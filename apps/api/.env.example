# For running the API directly from apps/api (pnpm --filter api dev).
# Copy to apps/api/.env. Never put any PostgreSQL URL in this runtime environment.
NODE_ENV=development
AUTH_PROVIDER=mock
PORT=3000
PERSISTENCE_RPC_URL=http://127.0.0.1:3001
# Generate with pnpm rpc:keys. Only the API receives the private key.
PERSISTENCE_RPC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
PERSISTENCE_RPC_KEY_ID=primary
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional first-party financial chat. API-only; disabled unless explicitly configured.
# Providers: openai, anthropic, google, openai-compatible; demo is offline/dev-only.
ASSISTANT_PROVIDER=disabled
# ASSISTANT_MODEL=your-explicit-tool-capable-model
# ASSISTANT_API_KEY=your-provider-key
# Only openai-compatible: trusted HTTPS, or explicit development loopback HTTP.
# ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1

# Optional live WebRTC voice. Single API replica only; separate live/cost authorization
# and dedicated provider project spend limit required. See assistant-live-voice.md.
ASSISTANT_VOICE_ENABLED=false
# ASSISTANT_VOICE_MODEL=your-explicit-realtime-audio-model
# ASSISTANT_VOICE_API_KEY=your-dedicated-server-only-key
# Recommended provider timbres: marin (default) or cedar. Applies to new calls.
ASSISTANT_VOICE_NAME=marin

# For Firebase instead of local mock auth, set AUTH_PROVIDER=firebase and a real
# FIREBASE_PROJECT_ID. Admin email/private key are optional but must be paired.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=service-account@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=your-private-key

# Optional Fintoc Movements integration. Configure all three together, API-only.
# Public/secret keys must use the same mode; keep real values in ignored local files.
# FINTOC_PUBLIC_KEY=pk_test_REPLACE_ME
# FINTOC_SECRET_KEY=sk_test_REPLACE_ME
# Separate stable 32-byte encryption key, represented as 64 hex characters.
# FINTOC_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BANKING_AUTOMATIC_SYNC_ENABLED=false

# Optional external MCP OAuth. Set all four together; otherwise /mcp is disabled.
# Issuer is a canonical origin, without a trailing slash or /mcp path.
# Use the same browser hostname for local API/UI (do not mix localhost/127.0.0.1).
# MCP_OAUTH_ISSUER=http://localhost:3000
# MCP_OAUTH_UI_ORIGIN=http://localhost:4200
# Generate NEW stable OAuth-only values with pnpm mcp:keys; never reuse bank/RPC keys.
# MCP_OAUTH_STATE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# MCP_OAUTH_JWKS='{"keys":[REPLACE_WITH_GENERATED_PRIVATE_SIGNING_JWK]}'
# Enable only behind a trusted TLS proxy that strips/replaces forwarded headers.
# MCP_OAUTH_TRUST_PROXY=false
