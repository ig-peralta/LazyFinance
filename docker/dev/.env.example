# Local operation of the development deployment Compose stack.
# Set WEB_DOMAIN to a UI HTTPS DNS name that points to the Docker host.
# The API hostname is fixed by apps/ui/src/environments/environment.ts.
DOCKER_USERNAME=igperalta
IMAGE_TAG=latest
WEB_DOMAIN=dev.example.com
ACME_EMAIL=dev@example.com

# Use URL-safe passwords (letters, numbers, hyphens or underscores) because the
# Compose file builds PostgreSQL connection URLs from these values.
POSTGRES_USER=lazyfinance_owner
POSTGRES_PASSWORD=replace-with-a-long-url-safe-owner-password
POSTGRES_DB=lazyfinance
PERSISTENCE_DATABASE_USER=lazyfinance_app
PERSISTENCE_DATABASE_PASSWORD=replace-with-a-long-url-safe-runtime-password

# Generate a matching key pair with `pnpm rpc:keys`; keep the private key API-only.
PERSISTENCE_RPC_PRIVATE_KEY=
PERSISTENCE_RPC_PUBLIC_KEY=
PERSISTENCE_RPC_KEY_ID=primary
FIREBASE_PROJECT_ID=lazyfinance-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Assistant and voice provider credentials are API-only. Voice is billable;
# configure provider-side spend limits and account authorization before enabling it.
ASSISTANT_PROVIDER=openai
ASSISTANT_MODEL=gpt-6-luna
ASSISTANT_API_KEY=
ASSISTANT_VOICE_ENABLED=true
ASSISTANT_VOICE_API_KEY=
ASSISTANT_VOICE_MODEL=gpt-realtime-2.1-mini
ASSISTANT_VOICE_NAME=marin

# Fintoc keys must use the same test/live mode; bank sync remains disabled.
FINTOC_PUBLIC_KEY=
FINTOC_SECRET_KEY=
FINTOC_TOKEN_ENCRYPTION_KEY=

# Production OAuth origins; the deploy proxy is trusted and must replace forwarded headers.
MCP_OAUTH_ISSUER=https://api.lazyfinance.online
MCP_OAUTH_UI_ORIGIN=https://lazyfinance.online
MCP_OAUTH_STATE_KEY=
MCP_OAUTH_JWKS=
MCP_OAUTH_TRUST_PROXY=true
