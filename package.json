{
  "name": "lazyfinance",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "rpc:generate": "node scripts/rpc-generate.mjs",
    "rpc:check": "node scripts/rpc-generate.mjs --check",
    "rpc:keys": "node scripts/rpc-keys.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "resources": "docker compose -f docker/local/resources.yml",
    "resources:up": "docker compose -f docker/local/resources.yml up -d",
    "resources:down": "docker compose -f docker/local/resources.yml down",
    "deploy:local": "docker compose -f docker/local/deploy.yml",
    "deploy:local:up": "docker compose -f docker/local/deploy.yml up --build -d",
    "deploy:local:down": "docker compose -f docker/local/deploy.yml down"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.22.3"
  }
}
